<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="product.info.addtocart">
            <block class="Magento\Catalog\Block\Product\View" name="mageprince.buynow.product.simple" template="Mageprince_BuyNow::buynow-view.phtml" before="-" ifconfig="buynow/general/enable_view">
                <arguments>
                    <argument name="view_model" xsi:type="object">Mageprince\BuyNow\ViewModel\BuyNow</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.addtocart.additional">
            <block class="Magento\Catalog\Block\Product\View" name="mageprince.buynow.product.config" template="Mageprince_BuyNow::buynow-view.phtml" before="-" ifconfig="buynow/general/enable_view">
                <arguments>
                    <argument name="view_model" xsi:type="object">Mageprince\BuyNow\ViewModel\BuyNow</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
